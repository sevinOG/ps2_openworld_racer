+void Renderer3DUtility::pushLine(const Vec4& from, const Vec4& to,
+                                 const Color& color) {
+  lineBatch[lineBatchCount].from = from;
+  lineBatch[lineBatchCount].to = to;
+  lineBatch[lineBatchCount].color = color;
+  lineBatchCount++;
+  if (lineBatchCount >= kLineBatchMax) flushLines();
+}
+
+void Renderer3DUtility::flushLines() {
+  if (lineBatchCount <= 0) return;
+
+  const s8 thickness = 2;
+  const int count = lineBatchCount;
+  const s16 packetSize = static_cast<s16>(24 * thickness * count);
+  auto* packet =
+      packet2_create(packetSize, P2_TYPE_NORMAL, P2_MODE_CHAIN, false);
+
+  packet2_chain_open_end(packet, 0, 0);
+  bool drew = false;
+
+  for (s8 pass = 0; pass < thickness; pass++) {
+    Vec4 scale(2048.0F + pass, 2048.0F + pass,
+               static_cast<float>(0xFFFFFF) / 32.0F, 1.0F);
+    for (int i = 0; i < count; i++) {
+      std::array<xyz_t, 2> outputVerts;
+      if (!calcLineVertices(outputVerts.data(), lineBatch[i].from,
+                            lineBatch[i].to, scale)) {
+        continue;
+      }
+      drew = true;
+      auto gsColor = getGSColor(lineBatch[i].color);
+      packet2_update(packet, draw_prim_start(packet->next, 0, &prim, &gsColor));
+      packet2_add_u64(packet, outputVerts[0].xyz);
+      packet2_add_u64(packet, outputVerts[1].xyz);
+      packet2_update(packet,
+                     draw_prim_end(packet->next, 2, TYRA_UTILS_LINE_REGLIST));
+      packet2_pad128(packet, 0);
+    }
+  }
+
+  lineBatchCount = 0;
+  if (!drew) {
+    packet2_free(packet);
+    return;
+  }
+
+  packet2_update(packet, draw_finish(packet->next));
+  packet2_chain_close_tag(packet);
+  dma_channel_wait(DMA_CHANNEL_GIF, 0);
+  dma_channel_send_packet2(packet, DMA_CHANNEL_GIF, true);
+  dma_channel_wait(DMA_CHANNEL_GIF, 0);
+  packet2_free(packet);
+}
